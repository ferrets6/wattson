# MQTT broker the Tasmota publishes to
MQTT_BROKER_URL=tcp://mqtt.example.lan:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=tele/tasmota/SENSOR

# Beszel (admin credentials of the existing Beszel instance)
BESZEL_URL=http://beszel:8090
BESZEL_ADMIN_EMAIL=
BESZEL_ADMIN_PASSWORD=

# Live-chart host CPU (internal/hostcpu, ~2s from /proc/stat). Docker
# exposes the host's own /proc/stat by default, so usually leave unset;
# override only to point at a bind-mounted /host/proc/stat.
HOSTCPU_PROC_STAT_PATH=

# Home Assistant (long-lived token to read pun_sensor)
HA_URL=http://homeassistant.example.lan:8123
HA_TOKEN=
HA_PUN_ENTITY_ID=
# cmd/backfill only: prefix of the Tasmota's HA energy entities (line 1),
# e.g. sensor.<device>_energy -> sensor.<device>_energy_power_0 etc.
HA_TASMOTA_ENTITY_PREFIX=

# Pricing: default spread applied to the PUN when no period overrides it
DEFAULT_SPREAD_EUR_KWH=0.10

# Attribution: container->category mapping (copy attribution.example.json to
# attribution.json and customize, then point this at it). Empty/unset =
# everything falls back to the "unknown" category, no error.
ATTRIBUTION_CONFIG_PATH=

# Auth (OIDC/Authelia, same pattern as hp-bios-webui). Empty = no
# application-level auth, assumes a forward-auth in front (Authelia/
# Keycloak/Tailscale Serve). Setting OIDC_ISSUER_URL makes all the others required.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
SESSION_SECRET_KEY=

# HTTP server
LISTEN_ADDR=:8080

# Storage
DB_PATH=./wattson.db
